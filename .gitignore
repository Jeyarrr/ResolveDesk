# Dependencies and package-manager caches (at any project depth)
node_modules/
.npm/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.yarn/install-state.gz
.pnp.*

# Local environment files; examples must contain placeholders only
.env
.env.*
!.env.example
!.env.*.example
!.env.sample
!.env.template
.envrc

# Credentials, private keys, and local secrets
.npmrc
.netrc
.pgpass
.pg_service.conf
secrets/
credentials/
*.pem
*.key
*.p12
*.pfx
*.keystore

# Build outputs and tool caches
dist/
build/
out/
.cache/
.vite/
.turbo/
.parcel-cache/
*.tsbuildinfo
coverage/
.nyc_output/
playwright-report/
test-results/

# Logs and runtime files
logs/
*.log
*.pid
*.pid.lock
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local database data, dumps, and user uploads
pgdata/
postgres-data/
backups/
uploads/
*.dump
*.backup
*.sqlite
*.sqlite3
# Keep SQL schema and migration files versioned.

# Editor and operating-system files
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
._*
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# Temporary files
tmp/
temp/
*.tmp
*.temp

# Dependency lockfiles are intentionally not ignored.
