{
  "name": "@resolvedesk/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:production": "node dist/db/migrate.js",
    "db:bootstrap": "tsx src/db/bootstrap.ts",
    "db:bootstrap:production": "node dist/db/bootstrap.js",
    "user:password:production": "node dist/db/provision.js",
    "db:seed": "tsx src/db/seed-cli.ts",
    "user:password": "tsx src/db/provision.ts",
    "storage:audit": "tsx src/db/storage-audit.ts"
  },
  "dependencies": {
    "@vercel/blob": "2.4.0",
    "@vercel/functions": "3.6.1",
    "argon2": "^0.45.1",
    "busboy": "^1.6.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "file-type": "^22.2.0",
    "helmet": "^8.3.0",
    "morgan": "^1.10.1",
    "pg": "^8.23.1",
    "socket.io": "^4.8.4",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@types/busboy": "^1.5.5",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.21.0"
  }
}
