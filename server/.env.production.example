# Copy values into Vercel Project Settings > Environment Variables (Production only).
# Never put these secrets in a VITE_ variable. Do not overwrite your local server/.env.
NODE_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Migration/operator connection; optional in Vercel, required for operator commands below.
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT.REGION.aws.neon.tech/neondb?sslmode=require
DB_SSL=true
DB_POOL_MAX=3
SESSION_SECRET=replace-with-a-random-64-character-hex-secret
CLIENT_ORIGIN=https://YOUR-PROJECT.vercel.app
COOKIE_SAME_SITE=lax
TRUST_PROXY=1
SERVERLESS=true
STORAGE_DRIVER=blob
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_REPLACE_WITH_PRIVATE_STORE_TOKEN
CRON_SECRET=replace-with-a-different-random-64-character-hex-secret
# Public frontend configuration. Same-origin /api is the default.
VITE_API_URL=/api

# Operator workstation only. Do NOT store bootstrap/password variables in Vercel.
# CONFIRM_PRODUCTION_BOOTSTRAP=yes
# BOOTSTRAP_ADMIN_NAME=Jayr
# BOOTSTRAP_ADMIN_EMAIL=you@example.com
# BOOTSTRAP_ADMIN_USERNAME=jear
# BOOTSTRAP_ADMIN_PASSWORD=use-a-unique-strong-password
