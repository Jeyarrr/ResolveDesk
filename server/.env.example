# Server only. Copy to server/.env and replace placeholders.
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
CLIENT_ORIGIN=http://127.0.0.1:5173
DATABASE_URL=postgresql://USERNAME:PASSWORD@YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require
SESSION_SECRET=replace-with-at-least-32-random-bytes
DB_SSL=true
DB_POOL_MAX=5
COOKIE_SAME_SITE=lax
TRUST_PROXY=0
CONFIRM_DEVELOPMENT_SEED=no
SEED_ADMIN_PASSWORD=
SEED_AGENT_PASSWORD=
SEED_EMPLOYEE_PASSWORD=
PROVISION_EMAIL=
PROVISION_PASSWORD=
