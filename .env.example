# Reference only. Backend loads server/.env; Vite loads client/.env.
# Copy each workspace's .env.example to its .env and fill server placeholders there.
DATABASE_URL=postgresql://USERNAME:PASSWORD@127.0.0.1:5432/resolvedesk
DB_SSL=false
SESSION_SECRET=replace-with-at-least-32-random-bytes
CLIENT_ORIGIN=http://127.0.0.1:5173
NODE_ENV=development
PORT=4000
VITE_API_URL=/api

# Private local attachments (relative paths resolve from the repository root).
# Keep custom directories private and outside public/dist/source paths.
UPLOAD_DIR=uploads
UPLOAD_MAX_FILE_BYTES=10485760
UPLOAD_MAX_FILES=5
UPLOAD_MAX_REQUEST_BYTES=53477376

# Background operations (milliseconds); requires the running Node backend.
EVENT_POLL_INTERVAL_MS=1000
SLA_CHECK_INTERVAL_MS=30000
